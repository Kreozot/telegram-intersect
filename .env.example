# Obtain your own credentials at https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional local settings:
HOST=127.0.0.1
PORT=4310
# Host port used by compose.yaml. The container always listens on port 4310 internally.
# INTERSECT_PORT=4310
# Maximum number of people that can be selected at the same time.
# MAX_SELECTED_PEOPLE=50
# DATA_DIR=data
# Local keys are generated in DATA_DIR when omitted.
# APP_ACCESS_KEY=at-least-24-random-characters
# SESSION_ENCRYPTION_KEY=64-hexadecimal-characters
# Hosted mode requires all three, an HTTPS reverse proxy, and a private backend port.
# PUBLIC_ORIGIN=https://intersect.example.com
# LOOPBACK_PROXY is reserved for the provided Docker Compose configuration. Do not enable it when
# publishing the application port on a non-loopback interface.
