{
  "name": "telegram-intersect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "init": "tsx scripts/init.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/server/main.ts --dev",
    "debug": "node --inspect=127.0.0.1:9229 --env-file-if-exists=.env --import tsx src/server/main.ts --dev",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "start": "node --env-file-if-exists=.env dist/server/server/main.js",
    "check": "biome check . && stylelint \"src/**/*.css\" && tsc --noEmit",
    "format": "biome check --write . && stylelint \"src/**/*.css\" --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:staged": "lint-staged",
    "prepare": "node .husky/install.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/middie": "9.3.4",
    "@fastify/static": "10.1.3",
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "big-integer": "1.6.52",
    "cytoscape": "3.34.3",
    "fastify": "5.12.3",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "teleproto": "1.229.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/cytoscape": "3.21.9",
    "@types/node": "24.13.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "inquirer": "14.2.2",
    "lint-staged": "17.5.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,css}": "biome check --no-errors-on-unmatched",
    "*.css": "stylelint"
  }
}
